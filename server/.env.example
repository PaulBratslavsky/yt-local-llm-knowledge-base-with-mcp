# --- Embeddings -------------------------------------------------------------
# The MCP `reindexEmbeddings` tool writes vectors from this process, and the
# client reads them. BOTH HALVES MUST AGREE: a vector is trusted only when
# its stored (embeddingModel, embeddingVersion) match the reader's. Set one
# side only and every vector this side writes reads as permanently stale on
# the other — related videos and semantic search go quietly empty.
#
# Mirror any change in client/.env.
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_VERSION=2

# Residential proxy for the YouTube caption fetch, used by the MCP
# `fetchTranscript` / `addVideo` tools. Leave empty for local dev.
TRANSCRIPT_PROXY_URL=
