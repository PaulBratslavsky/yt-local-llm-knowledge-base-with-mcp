
# Server
# Loopback for local development. The yt-kb plugin grants the Public role
# nothing, but the admin panel and /mcp listen here too, so widen it only
# deliberately (a hosted container needs 0.0.0.0).
HOST=127.0.0.1
PORT=1340

# Official Strapi MCP server (5.47+), served at /mcp. Default on; set to
# false to disable the MCP endpoint entirely.
MCP_ENABLED=true

# Secrets
APP_KEYS=5HfvmGDF+DTtOp9swpbkYg==,O5vK/+ws9w71/pZmo9kQQg==,sYBNTtyqbu95rdXMcR1nAw==,R+WeB55dRJ6uDJ/QFL+JTw==
API_TOKEN_SALT=U/q25+ZCPSyfpSVyRPz1Pg==
ADMIN_JWT_SECRET=QCITM+gvR5gzna9nADUhOA==
TRANSFER_TOKEN_SALT=76woe3WtqMZLzThBiPieSA==
ENCRYPTION_KEY=J1+rvUjIDa+4vIktx5Pcpg==

# Database
DATABASE_CLIENT=sqlite
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_FILENAME=.tmp/data.db
JWT_SECRET=ZjMHqQgNDcDukrc5TUmv0w==

# --- Embeddings -------------------------------------------------------------
# The app (client/) computes and writes the vectors, next to Ollama; Strapi
# only reads them (the relatedVideos MCP tool). BOTH HALVES MUST AGREE on
# these two values: a vector is trusted only when
# its stored (embeddingModel, embeddingVersion) match the reader's. Set one
# side only and every vector this side writes reads as permanently stale on
# the other — related videos and semantic search go quietly empty.
#
# Mirror any change in client/.env.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_VERSION=2

# Residential proxy for every YouTube request strapi-plugin-yt-kb makes
# (captions, metadata, oEmbed): the app's transcript fetch, GET
# /api/yt-kb/yt-transcript/:videoId and the MCP fetchTranscript / addVideo
# tools. The plugin's `proxyUrl` setting defaults to this variable (the same
# shape as strapi-plugin-youtube-transcripts). Leave empty for local dev;
# set it on a cloud host, whose IPs YouTube tends to block. At boot the
# plugin tests it against httpbin.org and logs the outbound IP.
# Example: http://user:pass@proxy.example.com:8080
PROXY_URL=
