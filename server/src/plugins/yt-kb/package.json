{
  "name": "strapi-plugin-yt-kb",
  "version": "0.1.2",
  "description": "YouTube knowledge base for Strapi 5: videos, tags, notes, digests and transcripts, with MCP tools for agents. AI runs in your own client; Strapi stores and serves.",
  "license": "GPL-3.0-or-later",
  "type": "commonjs",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "youtube",
    "mcp",
    "knowledge-base"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "verify": "strapi-plugin verify",
    "test": "vitest run",
    "test:ts:back": "tsc -p server/tsconfig.json --noEmit --incremental false"
  },
  "dependencies": {
    "undici": "6.29.1",
    "youtubei.js": "17.2.0"
  },
  "devDependencies": {
    "@strapi/sdk-plugin": "6.1.1",
    "@types/node": "^22.0.0",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.61.0",
    "@strapi/utils": "^5.61.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "yt-kb",
    "displayName": "YT Knowledge Base",
    "description": "Videos, tags, notes, digests and transcripts, with MCP tools for agents."
  }
}
