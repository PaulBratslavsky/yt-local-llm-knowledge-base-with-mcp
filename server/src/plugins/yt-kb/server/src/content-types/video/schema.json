{
  "kind": "collectionType",
  "collectionName": "yt_kb_videos",
  "info": {
    "singularName": "video",
    "pluralName": "videos",
    "displayName": "Video",
    "description": "A YouTube video added to the knowledge base. Each row holds the source metadata, the user's own caption/tags, the cached transcript, and the AI-generated summary. Dedupe key: `youtubeVideoId` (unique)."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": true
    },
    "content-type-builder": {
      "visible": false
    }
  },
  "attributes": {
    "transcript": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::yt-kb.transcript"
    },
    "youtubeVideoId": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 32
    },
    "url": {
      "type": "text",
      "required": true,
      "maxLength": 2000
    },
    "videoTitle": {
      "type": "text",
      "maxLength": 300
    },
    "videoAuthor": {
      "type": "string",
      "maxLength": 200
    },
    "videoThumbnailUrl": {
      "type": "text",
      "maxLength": 2000
    },
    "caption": {
      "type": "text",
      "maxLength": 500
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::yt-kb.tag",
      "inversedBy": "videos"
    },
    "digests": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::yt-kb.digest",
      "mappedBy": "videos"
    },
    "notes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::yt-kb.note",
      "mappedBy": "videos"
    },
    "summaryStatus": {
      "type": "enumeration",
      "enum": [
        "pending",
        "generated",
        "failed"
      ],
      "required": true,
      "default": "pending"
    },
    "summaryTitle": {
      "type": "string",
      "maxLength": 200
    },
    "summaryDescription": {
      "type": "text",
      "maxLength": 500
    },
    "summaryOverview": {
      "type": "richtext"
    },
    "readableArticle": {
      "type": "richtext"
    },
    "readableArticleGeneratedAt": {
      "type": "datetime"
    },
    "readableArticleModel": {
      "type": "string",
      "maxLength": 100
    },
    "watchVerdict": {
      "type": "enumeration",
      "enum": [
        "skip",
        "skim",
        "worth_it"
      ]
    },
    "verdictSummary": {
      "type": "text",
      "maxLength": 280
    },
    "verdictReason": {
      "type": "text",
      "maxLength": 1000
    },
    "valueScore": {
      "type": "integer",
      "min": 0,
      "max": 100
    },
    "valueScoreSource": {
      "type": "enumeration",
      "enum": [
        "model",
        "derived"
      ]
    },
    "signalScores": {
      "type": "json"
    },
    "signalScore": {
      "type": "integer",
      "min": 0,
      "max": 100
    },
    "finalScore": {
      "type": "integer",
      "min": 0,
      "max": 100
    },
    "summaryGeneratedAt": {
      "type": "datetime"
    },
    "aiModel": {
      "type": "string",
      "maxLength": 100
    },
    "transcriptSegments": {
      "type": "json"
    },
    "summaryEmbedding": {
      "type": "json",
      "description": "Topical embedding computed from title + overview + takeaways + section headings + tags. number[] \u2014 opaque to the admin; used for relatedVideos and library semantic search."
    },
    "embeddingModel": {
      "type": "string",
      "maxLength": 100,
      "description": "Ollama model that produced summaryEmbedding. Compound invalidation key with embeddingVersion \u2014 stored != current \u21d2 stale \u21d2 recompute."
    },
    "embeddingVersion": {
      "type": "integer",
      "description": "Version of the text-building logic that produced summaryEmbedding. Bumped when the set of fields fed into the embedder changes."
    },
    "embeddingGeneratedAt": {
      "type": "datetime"
    },
    "passageEmbeddings": {
      "type": "json",
      "description": "Tier-2 passage-level embeddings for moment search. Self-contained blob holding the chunker output: { model, version, generatedAt, chunks: [{ text, startSec, endSec, embedding }] }. Independent from summaryEmbedding \u2014 different invalidation key and chunker."
    },
    "keyTakeaways": {
      "type": "component",
      "repeatable": true,
      "component": "ytkb.takeaway"
    },
    "sections": {
      "type": "component",
      "repeatable": true,
      "component": "ytkb.section"
    },
    "actionSteps": {
      "type": "component",
      "repeatable": true,
      "component": "ytkb.action-step"
    }
  }
}
