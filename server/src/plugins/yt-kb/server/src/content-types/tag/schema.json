{
  "kind": "collectionType",
  "collectionName": "yt_kb_tags",
  "info": {
    "singularName": "tag",
    "pluralName": "tags",
    "displayName": "Tag",
    "description": "Free-form tag on a Post. Created on the fly at post time. Server-side normalization keeps `name` lowercase-trimmed so dedupe works."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": true
    },
    "content-type-builder": {
      "visible": false
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true,
      "minLength": 1,
      "maxLength": 40,
      "column": { "unique": true }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "column": { "unique": true }
    },
    "videos": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::yt-kb.video",
      "mappedBy": "tags"
    }
  }
}
