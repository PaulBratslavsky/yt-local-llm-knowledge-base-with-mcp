STRAPI_URL=http://localhost:1340

# Optional — a Strapi API token to include as `Authorization: Bearer` on
# every API call. Leave empty when public-role grants are sufficient (the
# default for local-first use). Set this if you lock down the Strapi API
# for remote deployments.
STRAPI_API_TOKEN=

# Transcripts are fetched directly from YouTube via youtubei.js — no external
# service needed. If your server IP gets the "sign in to confirm you're not a
# bot" wall (datacenter IPs sometimes do), set a residential proxy URL here.
# Leave empty for local dev.
TRANSCRIPT_PROXY_URL=

# Embedding invalidation keys. Read from the environment on BOTH halves —
# the Strapi server writes vectors too (MCP reindexEmbeddings), and a
# vector is trusted only when its stored (model, version) match the
# reader's. Mirror any change in server/.env, or the side you didn't
# change treats every new vector as stale.
#
# Bump EMBEDDING_VERSION when the embedding text-builder changes; bump
# PASSAGE_EMBEDDING_VERSION when the passage chunker or its context header
# changes. Then backfill from /settings.
EMBEDDING_VERSION=2
PASSAGE_EMBEDDING_VERSION=3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Ollama — local-first AI. Install from https://ollama.com/download, then
# build the default model from the repo root:
#   ollama create gemma4-kb -f Modelfile
# (or use any chat-capable model — see the Modelfile for why it sets
# num_ctx). Summary generation goes through this, no API key, no credits,
# no rate limits.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4-kb:latest
# Optional — separate model for chat Q&A. Defaults to OLLAMA_MODEL when
# unset OR left empty (e.g. `OLLAMA_CHAT_MODEL=`).
OLLAMA_CHAT_MODEL=

# Map-step concurrency for long-video summarization (map-reduce path).
# Default 1 is safe on any hardware. Bump when you have RAM headroom:
#   - 24GB M4 with Chrome/editor open → keep at 1 (else swaps, slower)
#   - 48GB M4 Max / M4 Pro            → 2 is comfortable
#   - 64GB+                           → 3 works
# Must match `OLLAMA_NUM_PARALLEL` on the Ollama server (set via
# `launchctl setenv OLLAMA_NUM_PARALLEL 2` and restart the Ollama app).
# MAP_CONCURRENCY=1
