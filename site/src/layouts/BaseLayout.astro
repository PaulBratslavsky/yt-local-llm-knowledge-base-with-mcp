---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-white text-slate-900">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body class="mx-auto max-w-3xl px-5 py-10">
    <header class="mb-10 flex items-baseline gap-4">
      <a class="text-sm font-medium text-slate-900" href="/">YT knowledge base</a>
      <a class="text-sm text-slate-500 hover:text-slate-900" href="/articles">Articles</a>
    </header>
    <main>
        <slot />
    </main>

    <!-- Cmd-K from any page. Pages other than the home page ship no
         JavaScript, so there is no search box here to focus — this sends
         you to the one that has it. Inline and ~200 bytes, rather than
         loading the 20KB search island on all 186 pages. -->
    <script is:inline>
      document.addEventListener('keydown', (event) => {
        if (!(event.metaKey || event.ctrlKey) || event.key.toLowerCase() !== 'k') return;
        // The home page's island owns the shortcut where a box exists.
        if (document.querySelector('[data-search-input]')) return;
        event.preventDefault();
        window.location.href = '/';
      });
    </script>
  </body>
</html>
