---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox.astro';
---

<BaseLayout title="Not found · YT Knowledge Base">
  <h1 class="text-[38px] font-semibold leading-tight tracking-[-0.03em] text-[var(--ink)]">
    Nothing here
  </h1>
  <p class="mt-3 text-[16px] text-[var(--ink-muted)]">
    That page does not exist. Search for a video instead.
  </p>
  <div class="mt-7">
    <SearchBox autofocus={true} />
  </div>
</BaseLayout>
