---
import type { Video } from '../lib/video';
import { displayTitle } from '../lib/video';

interface Props {
  video: Video;
}

const { video } = Astro.props;

const VERDICT_LABEL = {
  worth_it: 'Worth watching',
  skim: 'Skim it',
  skip: 'Skip it',
} as const;

const highScore = (video.finalScore ?? 0) >= 85;
---

<a
  class="block rounded-2xl border border-[var(--line)] bg-[var(--card)] px-6 py-5 no-underline transition-colors hover:border-[var(--line-strong)]"
  href={`/v/${video.youtubeVideoId}`}
>
  <div class="flex items-start gap-4">
    <div class="min-w-0 flex-1">
      <h3
        class="text-[18px] font-semibold leading-snug tracking-[-0.012em] text-[var(--ink)]"
      >
        {displayTitle(video)}
      </h3>
      {
        video.videoAuthor && (
          <p class="mt-1 text-[13.5px] text-[var(--ink-muted)]">{video.videoAuthor}</p>
        )
      }
      {
        video.summaryDescription && (
          <p class="mt-2 text-[15px] leading-relaxed text-[var(--ink-soft)]">
            {video.summaryDescription}
          </p>
        )
      }
    </div>

    <div class="flex flex-none flex-col items-end gap-2">
      {
        typeof video.finalScore === 'number' && (
          <span
            class="inline-flex h-8 min-w-[46px] items-center justify-center rounded-[9px] px-2.5 text-[15px] font-semibold tabular-nums"
            style={
              highScore
                ? 'background: var(--ok-bg); color: var(--ok-text)'
                : 'background: var(--chip-bg); color: var(--ink-soft)'
            }
          >
            {video.finalScore}
          </span>
        )
      }
      {
        video.watchVerdict && (
          <span class="text-[12px] text-[var(--ink-faint)]">
            {VERDICT_LABEL[video.watchVerdict]}
          </span>
        )
      }
    </div>
  </div>
</a>
