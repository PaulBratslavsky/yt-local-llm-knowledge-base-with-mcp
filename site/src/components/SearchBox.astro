---
interface Props {
  autofocus?: boolean;
}

const { autofocus = false } = Astro.props;
---

<div>
  <div class="relative">
    <span
      aria-hidden="true"
      class="pointer-events-none absolute left-5 top-1/2 flex -translate-y-1/2 text-[var(--ink-faint)]"
    >
      <svg
        fill="none"
        height="19"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="19"
      >
        <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path>
      </svg>
    </span>
    <label class="sr-only" for="site-search">Search the library</label>
    <input
      autofocus={autofocus}
      class="h-[62px] w-full rounded-[15px] border border-[var(--line-strong)] bg-[var(--card)] pl-[54px] pr-[72px] text-[18px] text-[var(--ink)] outline-none placeholder:text-[var(--ink-faint)] focus:border-[var(--accent)]"
      data-search-input
      id="site-search"
      placeholder="Try: local models, agent experience, strapi…"
      type="search"
    />
    <kbd
      class="pointer-events-none absolute right-[18px] top-1/2 -translate-y-1/2 rounded-md border border-[var(--line)] px-2 py-1 font-sans text-[12px] text-[var(--ink-faint)]"
    >
      ⌘K
    </kbd>
  </div>

  <div class="mt-3.5 flex flex-wrap items-center gap-2">
    <button
      aria-pressed="true"
      class="facet-chip h-9 rounded-full border border-[var(--line)] bg-[var(--card)] px-3.5 text-[13.5px] font-medium text-[var(--ink-soft)]"
      data-facet="all"
      type="button"
    >
      Everything
    </button>
    <button
      aria-pressed="false"
      class="facet-chip h-9 rounded-full border border-[var(--line)] bg-[var(--card)] px-3.5 text-[13.5px] font-medium text-[var(--ink-soft)]"
      data-facet="worth"
      type="button"
    >
      Worth watching
    </button>
    <button
      aria-pressed="false"
      class="facet-chip h-9 rounded-full border border-[var(--line)] bg-[var(--card)] px-3.5 text-[13.5px] font-medium text-[var(--ink-soft)]"
      data-facet="high"
      type="button"
    >
      Score 85+
    </button>

    <label class="sr-only" for="search-tag">Filter by topic</label>
    <select
      class="h-9 rounded-full border border-[var(--line)] bg-[var(--card)] px-3 text-[13.5px] text-[var(--ink-soft)] disabled:opacity-50"
      data-search-tag
      disabled
      id="search-tag"
    >
      <option value="">All topics</option>
    </select>
  </div>

  <ul class="mt-6 grid list-none gap-2.5 p-0" data-search-results></ul>
</div>

<script>
  import './search-client.ts';
</script>
