---
import type { Video } from '../lib/video';

interface Props {
  steps: Video['actionSteps'];
}

const { steps } = Astro.props;
---

{
  steps.length > 0 && (
    <section class="mt-10">
      <h2 class="text-xs font-semibold uppercase tracking-[0.08em] text-[var(--ink-muted)]">
        Your plan
      </h2>
      <ol class="mt-4 grid list-none gap-2.5 p-0">
        {steps.map((step, i) => (
          <li class="flex gap-4 rounded-2xl border border-[var(--line)] bg-[var(--card)] px-5 py-5">
            <span class="flex h-[30px] w-[30px] flex-none items-center justify-center rounded-full bg-[var(--invert-bg)] text-sm font-semibold text-[var(--invert-fg)]">
              {i + 1}
            </span>
            <div class="min-w-0">
              <h3 class="text-base font-semibold leading-snug text-[var(--ink)]">
                {step.title}
              </h3>
              {step.body && (
                <p class="mt-1.5 text-[15px] leading-relaxed text-[var(--ink-soft)]">
                  {step.body}
                </p>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>
  )
}
