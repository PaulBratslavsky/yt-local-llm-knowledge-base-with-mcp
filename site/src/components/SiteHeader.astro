---
interface Props {
  active?: 'library' | 'articles' | 'topics';
}

const { active } = Astro.props;

const LINKS = [
  { id: 'library', href: '/', label: 'Library' },
  { id: 'articles', href: '/articles', label: 'Articles' },
  { id: 'topics', href: '/topics', label: 'Topics' },
] as const;
---

<header
  class="sticky top-0 z-40 border-b border-[var(--line)] bg-[var(--header-bg)] backdrop-blur-lg"
>
  <nav class="flex items-center gap-6 px-5 py-3 sm:px-8">
    <a class="inline-flex items-center gap-2.5 no-underline" href="/">
      <span
        class="flex h-8 w-8 items-center justify-center rounded-[9px] bg-[var(--invert-bg)] text-[var(--invert-fg)]"
      >
        <svg
          aria-hidden="true"
          fill="none"
          height="16"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-width="2.5"
          viewBox="0 0 24 24"
          width="16"
        >
          <path d="M4 6h16"></path><path d="M4 12h16"></path><path d="M10 18h10"></path>
        </svg>
      </span>
      <span class="hidden text-[15px] font-semibold tracking-tight text-[var(--ink)] sm:inline">
        YT Knowledge Base
      </span>
    </a>

    <div class="flex items-center gap-4 sm:gap-5">
      {
        LINKS.map((link) => (
          <a
            class:list={[
              'text-sm no-underline hover:text-[var(--ink)]',
              active === link.id
                ? 'font-medium text-[var(--ink)]'
                : 'text-[var(--ink-muted)]',
            ]}
            href={link.href}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="ml-auto flex items-center gap-2">
      <a
        class="inline-flex h-9 items-center gap-2.5 rounded-[9px] border border-[var(--line)] bg-[var(--card)] px-3 text-[13.5px] text-[var(--ink-muted)] no-underline hover:text-[var(--ink)]"
        href="/"
      >
        <svg
          aria-hidden="true"
          fill="none"
          height="15"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="15"
        >
          <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path>
        </svg>
        <span class="hidden sm:inline">Search</span>
        <kbd
          class="hidden rounded-[5px] border border-[var(--line-strong)] px-1.5 py-0.5 font-sans text-[11px] text-[var(--ink-faint)] sm:inline"
        >
          ⌘K
        </kbd>
      </a>

      <button
        aria-label="Switch theme"
        class="inline-flex h-9 w-9 items-center justify-center rounded-[9px] border border-[var(--line)] bg-[var(--card)] text-[var(--ink)]"
        data-theme-toggle
        title="Switch theme"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="icon-sun"
          fill="none"
          height="16"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="16"
        >
          <circle cx="12" cy="12" r="4.2"></circle>
          <path
            d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6L17 7M7 17l-1.4 1.4"
          ></path>
        </svg>
        <svg
          aria-hidden="true"
          class="icon-moon"
          fill="none"
          height="16"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="16"
        >
          <path d="M20 14.5A8.5 8.5 0 019.5 4a8.5 8.5 0 1010.5 10.5z"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  import './theme-client.ts';
</script>
