---
import type { Video } from '../lib/video';
import { orderedSections } from '../lib/sections';
import { formatTimecode, youtubeUrlAt } from '../lib/video';
import { renderMarkdown } from '../lib/markdown';

interface Props {
  videoId: string;
  sections: Video['sections'];
}

const { videoId, sections } = Astro.props;
const ordered = orderedSections(sections);
---

{
  ordered.length > 0 && (
    <section class="mt-10">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="text-xs font-semibold uppercase tracking-[0.08em] text-[var(--ink-muted)]">
          Walkthrough
        </h2>
        <p class="text-[13px] text-[var(--ink-muted)]">
          Timecodes come from the transcript, not the model
        </p>
      </div>

      <div class="mt-4 grid gap-3">
        {ordered.map((s) => (
          <article
            class="section-card rounded-2xl border border-[var(--line)] bg-[var(--card)] px-6 py-5"
            data-section-card
          >
            <div class="flex items-center gap-3.5">
              {typeof s.timeSec === 'number' ? (
                <button
                  class="seek-chip inline-flex h-11 flex-none items-center gap-2.5 rounded-full border border-[var(--accent-line)] bg-[var(--accent-soft)] py-0 pl-3.5 pr-[18px] text-[15px] font-semibold tabular-nums text-[var(--accent-text)]"
                  data-seek={Math.floor(s.timeSec)}
                  data-seek-label={s.heading}
                  type="button"
                >
                  <svg
                    aria-hidden="true"
                    fill="currentColor"
                    height="15"
                    viewBox="0 0 24 24"
                    width="15"
                  >
                    <path d="M8 5.5v13l11-6.5z" />
                  </svg>
                  {formatTimecode(s.timeSec)}
                </button>
              ) : (
                /* ADR-0004: the pipeline leaves a section ungrounded rather
                   than inventing a timecode. Neither does this page. */
                <span
                  class="inline-flex h-11 flex-none items-center rounded-full border border-dashed border-[var(--line-strong)] px-4 text-[15px] font-semibold tabular-nums text-[var(--ink-faint)]"
                  title="No confident transcript match for this section"
                >
                  --:--
                </span>
              )}
              <h3 class="min-w-0 flex-1 text-[19px] font-semibold leading-tight tracking-[-0.012em] text-[var(--ink)]">
                {s.heading}
              </h3>
            </div>

            {s.body && (
              <div
                class="prose prose-sm mt-3.5 max-w-none text-[15.5px] leading-relaxed"
                set:html={renderMarkdown(s.body)}
              />
            )}

            {typeof s.timeSec === 'number' && (
              <p class="mt-3">
                <a
                  class="text-[13px] text-[var(--ink-faint)] no-underline hover:text-[var(--ink-muted)] hover:underline"
                  href={youtubeUrlAt(videoId, s.timeSec)}
                  rel="noopener"
                  target="_blank"
                >
                  Open this moment on YouTube
                </a>
              </p>
            )}
          </article>
        ))}
      </div>
    </section>
  )
}
